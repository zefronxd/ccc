    pass


async def download_via_api(link: str, media_type: str = "audio") -> Union[str, None]:
    """Download audio/video using API fallback."""
    global YOUR_API_URL
    
    if not YOUR_API_URL:
        await load_api_url()
        if not YOUR_API_URL:
            YOUR_API_URL = FALLBACK_API_URL
    
    video_id = link.split("v=")[-1].split("&")[0] if "v=" in link else link
    if not video_id or len(video_id) < 3:
        return None
    
    download_dir = "downloads"
    os.makedirs(download_dir, exist_ok=True)
    file_path = os.path.join(download_dir, f"{video_id}.{'mp3' if media_type == 'audio' else 'mp4'}")
    
    if os.path.exists(file_path):
        return file_path
    
    try:
        async with aiohttp.ClientSession() as session:
            params = {"url": video_id, "type": media_type}
            
            async with session.get(
                f"{YOUR_API_URL}/download",
                params=params,
                timeout=aiohttp.ClientTimeout(total=60),
            ) as response:
                if response.status != 200:
                    return None
                
                data = await response.json()
                download_token = data.get("download_token")
                if not download_token:
                    return None
                
                stream_url = f"{YOUR_API_URL}/stream/{video_id}?type={media_type}"
                
                async with session.get(
                    stream_url,
                    headers={"X-Download-Token": download_token},
                    timeout=aiohttp.ClientTimeout(total=600 if media_type == "video" else 300),
                ) as file_response:
                    if file_response.status != 200:
                        return None
                    
                    with open(file_path, "wb") as f:
                        async for chunk in file_response.content.iter_chunked(16384):
                            f.write(chunk)
                    
                    return file_path
    except Exception as e:
        print(f"API download failed: {e}")
        return None


def cookie_txt_file():
    """Get cookie file - prioritize hardcoded cookies first, then fallback to cookies directory."""
    # First try hardcoded cookies
    hardcoded = get_hardcoded_cookie_file()
    if hardcoded:
        return hardcoded
    
    # Fallback to cookies directory
    cookie_dir = f"{os.getcwd()}/cookies"
    if not os.path.exists(cookie_dir):
        return None
    cookies_files = [f for f in os.listdir(cookie_dir) if f.endswith(".txt")]
    if not cookies_files:
        return None
    cookie_file = os.path.join(cookie_dir, random.choice(cookies_files))
    return cookie_file


async def download_song(link: str):
    """Download song - try hardcoded cookies first, then fallback to API."""
    video_id = link.split('v=')[-1].split('&')[0]
    download_folder = "downloads"
    os.makedirs(download_folder, exist_ok=True)
    
    # Check if file already exists
    for ext in ["mp3", "m4a", "webm", "opus"]:
        file_path = os.path.join(download_folder, f"{video_id}.{ext}")
        if os.path.exists(file_path):
            return file_path
    
    # First try: Hardcoded cookies
    cookie_file = get_hardcoded_cookie_file()
    if cookie_file:
        loop = asyncio.get_running_loop()
        
        def _download_with_cookies():
            try:
                ydl_opts = {
                    "format": "bestaudio/best",
                    "outtmpl": os.path.join(download_folder, f"{video_id}.%(ext)s"),
                    "geo_bypass": True,
                    "nocheckcertificate": True,
                    "quiet": True,
                    "cookiefile": cookie_file,
                    "no_warnings": True,
                    "postprocessors": [{
                        "key": "FFmpegExtractAudio",
                        "preferredcodec": "mp3",
                        "preferredquality": "192",
                    }],
                }
                ydl = yt_dlp.YoutubeDL(ydl_opts)
                info = ydl.extract_info(link, download=False)
                file_path = os.path.join(download_folder, f"{info['id']}.mp3")
                if os.path.exists(file_path):
                    return file_path
                ydl.download([link])
                return file_path
            except Exception as e:
                print(f"Hardcoded cookie download failed: {e}")
                return None
        
        try:
            file_path = await loop.run_in_executor(None, _download_with_cookies)
            if file_path and os.path.exists(file_path):
                return file_path
        except Exception as e:
            print(f"Error with hardcoded cookies: {e}")
    
    # Fallback: Try API
    print("Falling back to API download for song...")
    return await download_via_api(link, "audio")


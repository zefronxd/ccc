def get_hardcoded_cookie_file():
    """Create a temporary file with hardcoded cookies and return its path."""
    global _hardcoded_cookie_file
    if _hardcoded_cookie_file and os.path.exists(_hardcoded_cookie_file):
        return _hardcoded_cookie_file
    
    try:
        temp_fd, temp_path = tempfile.mkstemp(suffix='.txt', prefix='youtube_cookies_')
        with os.fdopen(temp_fd, 'w') as f:
            f.write(HARDCODED_COOKIES)
        _hardcoded_cookie_file = temp_path
        return temp_path
    except Exception as e:
        print(f"Error creating hardcoded cookie file: {e}")
        return None


async def load_api_url():
    """Load API URL from remote source."""
    global YOUR_API_URL
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pastebin.com/raw/rLsBhAQa",
                timeout=aiohttp.ClientTimeout(total=10),
            ) as response:

[Unit]
Description=Zefron Music Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zefronmusic
Group=zefronmusic
WorkingDirectory=APP_DIR
EnvironmentFile=APP_DIR/.env
ExecStart=APP_DIR/.venv/bin/python -m ZEFRONMUSIC
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT

# Keep logs available through journalctl without writing credentials to disk.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zefronmusic

[Install]
WantedBy=multi-user.target